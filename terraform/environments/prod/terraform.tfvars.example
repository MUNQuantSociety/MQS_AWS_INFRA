# Copy to terraform.tfvars and fill in real values. Do NOT commit terraform.tfvars.

aws_region          = "us-east-2"
project_name        = "mqsmaster"
environment         = "prod"
# Existing repo, adopted (not created) by Terraform. Must already exist.
ecr_repository_name = "livetradingbot"
# Must be a tag that exists in that repo; it carries no "latest".
image_tag           = "1.0.5-4"

# CI/CD. github_repository is the repo GitHub Actions RUNS deploy.yml in -- the
# MQSMaster repo with the Dockerfile, not this one. A fork's OIDC tokens carry a
# different owner/repo and will be rejected, so change this if you build from a
# fork. github_allowed_refs defaults to main only; widening it (e.g. adding
# "pull_request") lets more workflow runs assume the deploy role.
github_repository   = "MUNQuantSociety/MQSMaster"
# github_allowed_refs = ["ref:refs/heads/main"]

# Networking. Defaults build a dedicated VPC: workloads in private subnets,
# IGW + one NAT gateway in the public subnets. All optional - omit to accept
# the defaults below.
#
# single_nat_gateway is the main cost lever here: true = one NAT (~$32/mo),
# false = one per AZ (~$97/mo) for HA egress.
#
# az_count = 2 is the floor: RDS subnet groups require two AZs. It is NOT a cost
# lever -- single_nat_gateway caps NAT at one gateway whatever the AZ count, and
# subnets/route tables/IGW carry no hourly charge. Raise it for spread, not spend.
vpc_cidr             = "10.0.0.0/16"
az_count             = 2
private_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"] # tasks + RDS
public_subnet_cidrs  = ["10.0.4.0/24", "10.0.5.0/24"] # IGW + NAT only
single_nat_gateway   = true

# Market task (scheduled, Mon-Fri).
market_task_cpu    = "2048" # 2 vCPU
market_task_memory = "8192" # 8 GB

# NLP service (always-on). Drop to "256"/"2048" for ~$11/mo, slower batches.
nlp_task_cpu      = "512"  # .5 vCPU
nlp_task_memory   = "2048" # 2 GB - FinBERT base floor
nlp_desired_count = 1

log_retention_days = 1

# RDS PostgreSQL. 4 GB RAM = 2 vCPU burstable.
db_engine_version          = "16"
db_instance_class          = "db.t4g.medium" # 2 vCPU / 4 GB (Graviton). db.t3.medium for x86.
db_allocated_storage       = 200             # GB. Set 300 for more headroom.
db_max_allocated_storage   = 300             # autoscale ceiling; == allocated to disable.
db_multi_az                = false           # true = HA standby, ~2x cost.
db_backup_retention_period = 7
# Prod-safe. deletion_protection = true makes `terraform destroy` FAIL until you
# flip it back and apply -- that is the point. skip_final_snapshot = false takes
# a snapshot named <name_prefix>-postgres-final on delete; that name is fixed, so
# delete or rename an old snapshot before a second teardown or RDS rejects it.
# For a throwaway environment, invert both.
db_deletion_protection     = true
db_skip_final_snapshot     = false

# Cron fires at local clock time in schedule_timezone (DST-aware).
# 11:00 America/St_Johns == 09:30 ET market open (Newfoundland is ET+1:30).
# Do NOT move this earlier: start.sh checks is_market_open immediately after
# launching and shuts the session down if the market is not open yet.
schedule_expression    = "cron(0 11 ? * MON-FRI *)"
schedule_timezone      = "America/St_Johns"
use_scheduler_timezone = true

# db_user/password/database become the RDS master creds. host is ignored
# (RDS endpoint injected automatically). password: min 8 chars, no / @ " space.
db_secret_values = {
  db_user  = "mqsadmin"
  password = "REPLACE_ME"
  host     = "" # ignored — RDS endpoint used
  port     = "5432"
  database = "mqsdb"
  sslmode  = "prefer"
}

api_secret_values = {
  FMP_API_KEY = "REPLACE_ME"
  ALPHA_KEY   = "REPLACE_ME"
  APIFY_KEY   = "REPLACE_ME"
}

# Credential values above are write-only: they never enter Terraform state or
# plan output, which also means Terraform cannot tell when you change one.
# After editing a value above, BUMP the matching counter or apply is a no-op.
# Bumping rewrites every parameter in that group, discarding out-of-band
# rotations — to rotate a single credential, prefer `aws ssm put-parameter`
# (see docs/operations.md#rotating-secrets).
db_parameter_version  = 1
api_parameter_version = 1
