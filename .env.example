# Copy to .env and fill real values. Do NOT commit .env.
# Source before running terraform / aws cli: `set -a && source .env && set +a`

###############################################################################
# AWS authentication
###############################################################################
AWS_REGION=us-east-2
# Pick ONE auth method below.
AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

###############################################################################
# Terraform variable overrides (TF_VAR_<name> maps to var.<name>)
###############################################################################
# TF_VAR_project_name=mqsmaster
# TF_VAR_environment=prod
# TF_VAR_image_tag=latest
# TF_VAR_aws_region=us-east-2

###############################################################################
# Database credentials (stored in SSM Parameter Store: /mqsmaster-prod/db/*)
###############################################################################
db_user=
password=
host=
port=5432
database=mqsdb
sslmode=prefer

###############################################################################
# Third-party API keys (stored in SSM Parameter Store: /mqsmaster-prod/api/*)
###############################################################################
FMP_API_KEY=
ALPHA_KEY=
APIFY_KEY=

###############################################################################
# CI/CD (GitHub Actions OIDC role)
###############################################################################
# IAM role ARN that GitHub Actions assumes. Store this in the GitHub repo
# secret AWS_DEPLOY_ROLE_ARN — not in this file once filled.
AWS_DEPLOY_ROLE_ARN=

###############################################################################
# ECS / image references (set by `terraform output` after apply)
###############################################################################
# ECR_REPOSITORY_URL=
# ECS_CLUSTER_NAME=mqsmaster-prod-cluster
# MARKET_TASK_FAMILY=mqsmaster-prod
# NLP_TASK_FAMILY=mqsmaster-prod-nlp
# NLP_SERVICE_NAME=mqsmaster-prod-nlp
# LOG_GROUP_NAME=/ecs/mqsmaster-prod
