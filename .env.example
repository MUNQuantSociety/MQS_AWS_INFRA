# =============================================================================
# Copy to .env and fill in real values.  cp .env.example .env
#
# .env is gitignored and must stay that way. This repository is PUBLIC.
#
# NOTHING READS THIS FILE AUTOMATICALLY. Neither Terraform nor the aws CLI
# knows what a .env file is -- both read the process ENVIRONMENT. This file is
# inert until you load it into your shell:
#
#   .\scripts\load-env.ps1                # PowerShell  (see scripts/load-env.ps1)
#   set -a && . ./.env && set +a          # bash / zsh / git-bash
#
# Run that once per terminal, before terraform or aws. Open a new terminal and
# you have to run it again -- if `aws sts get-caller-identity` starts asking for
# credentials, that is the symptom.
#
# WHY THIS FILE EXISTS RATHER THAN terraform.tfvars
# -------------------------------------------------
# Terraform reads a sensitive variable from TF_VAR_<name> exactly as it would
# from terraform.tfvars, so you can deploy with NO plaintext credential file on
# disk at all. That removes the single most common leak path in this repo's
# history of near-misses: a terraform.tfvars that gets force-added, copied into
# a new environment directory, or synced by OneDrive.
#
# Both routes are documented below. Pick one and use it consistently.
#
# WHAT NEVER GOES IN HERE
# -----------------------
#   - AWS access keys, if you can avoid them. Prefer AWS_PROFILE with SSO, or
#     the GitHub Actions OIDC role for CI. A long-lived AKIA key in a file is
#     the thing most likely to end up published.
#   - Anything that belongs in a GitHub repo secret (AWS_DEPLOY_ROLE_ARN).
# =============================================================================


###############################################################################
# AWS authentication  --  pick exactly ONE of the two blocks below
#
# Terraform needs these because both HCP workspaces run in LOCAL execution
# mode: HCP stores the state, but the plan and apply run on your machine with
# your AWS credentials.
#
# AWS_REGION is for the aws CLI. Terraform takes its region from
# var.aws_region (providers.tf), so the two are set independently on purpose.
###############################################################################
AWS_REGION=us-east-2
AWS_DEFAULT_REGION=us-east-2

# --- Option A: access keys in this file ---
# Simplest, and what the loader script expects. The moment you fill these in,
# this file holds a live AWS credential: it is gitignored, keep it that way,
# restrict it to your user, and rotate the key when the work is done.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary/STS credentials. Leave empty for a long-lived access key.
AWS_SESSION_TOKEN=

# --- Option B: a named profile, no secret in this file ---
# Better if you have SSO or a role available. Requires `aws configure --profile
# mqs` (or an SSO login) first, which writes ~/.aws/credentials OUTSIDE this
# repo. Uncomment this and blank out Option A -- do not set both.
#
# A profile name that does not exist fails with "The config profile could not
# be found", which is why this ships commented out.
# AWS_PROFILE=mqs

# HCP Terraform (state backend for both stacks). Prefer `terraform login`,
# which writes ~/.terraform.d/credentials.tfrc.json instead of an env var.
# TF_TOKEN_app_terraform_io=


###############################################################################
# STACK 1 — Livetrading   (terraform/environments/Livetrading)
#
# 9 SSM SecureString parameters, created by modules/Livetrading/ssm-parameters:
#   /mqsmaster-prod/db/{db_user,password,host,port,database,sslmode}
#   /mqsmaster-prod/api/{FMP_API_KEY,ALPHA_KEY,APIFY_KEY}
#
# db_user / password / database also become the RDS master credentials.
# host is IGNORED — locals.tf overwrites it with the live RDS endpoint.
###############################################################################

# --- Non-secret ---
TF_VAR_aws_region=us-east-2
TF_VAR_project_name=mqsmaster
TF_VAR_environment=prod
# Must be a tag that exists in the ECR repo — it carries no "latest".
TF_VAR_image_tag=1.0.5-6
TF_VAR_github_repository=MUNQuantSociety/MQSMaster

# --- Secret: RDS master + /db/* parameters ---
# One JSON object, matching var.db_secret_values. Password: min 8 chars, and no
# / @ " or space (RDS rejects them).
TF_VAR_db_secret_values={"db_user":"mqsadmin","password":"","host":"","port":"5432","database":"mqsdb","sslmode":"require"}

# --- Secret: /api/* parameters ---
# All three keys are REQUIRED by the object type in variables.tf. Leaving one
# out is a type error; leaving it as REPLACE_ME silently stores the literal
# string "REPLACE_ME" as the credential.
TF_VAR_api_secret_values={"FMP_API_KEY":"","ALPHA_KEY":"","APIFY_KEY":""}

# Bump the matching counter after changing a value above, or apply is a no-op —
# write-only arguments are invisible to Terraform's diff.
TF_VAR_db_parameter_version=1
TF_VAR_api_parameter_version=1

# --- RDS sizing (optional; variables.tf already defaults to these) ---
# Instance class is an in-place modify with one reboot — safe to change later.
# Allocated storage is NOT: it grows but never shrinks, so raising it is a
# one-way door. Autoscaling lifts it to the ceiling on its own when needed.
# TF_VAR_db_instance_class=db.t4g.small
# TF_VAR_db_allocated_storage=100
# TF_VAR_db_max_allocated_storage=200


###############################################################################
# STACK 2 — Backtest_Visualizer   (terraform/environments/Backtest_Visualizer)
#
# 8 SSM SecureString parameters, created by
# modules/Backtest_Visualizer/ssm-parameters:
#   /mqs-btv-prod/market-data/{MARKET_DATA_HOST,_PORT,_DB,_USER,_PASSWORD,_SSLMODE}
#   /mqs-btv-prod/api/{FMP_API_KEY,SUPABASE_ANON_KEY}
#
# This stack provisions NO database. MARKET_DATA_* points at an existing
# Postgres that must accept connections from the internet.
#
# The two stacks bind different HCP workspaces and share nothing. Do not source
# one .env for both — TF_VAR_project_name and the secret objects collide.
# Keep .env.livetrading and .env.btv, both gitignored by the `.env*` rule.
###############################################################################

# --- Non-secret ---
# TF_VAR_project_name=mqs-btv
# TF_VAR_ecr_repository_name=mqs-backtest-visualizer
# TF_VAR_certificate_arn=
# TF_VAR_supabase_project_ref=
# TF_VAR_cors_origins=["https://your-app.vercel.app"]

# --- Secret: external market_data Postgres, READ-ONLY role ---
# MARKET_DATA_SSLMODE must be "require" or stronger — this crosses the public
# internet, and "prefer" silently falls back to plaintext.
# TF_VAR_market_data_secret_values={"MARKET_DATA_HOST":"","MARKET_DATA_PORT":"5432","MARKET_DATA_DB":"","MARKET_DATA_USER":"","MARKET_DATA_PASSWORD":"","MARKET_DATA_SSLMODE":"require"}

# --- Secret: third-party ---
# SUPABASE_ANON_KEY is the only Supabase value held as a secret. SUPABASE_URL,
# SUPABASE_JWKS_URL and JWT_ISSUER are derived from supabase_project_ref and
# are public identifiers.
# TF_VAR_api_secret_values={"FMP_API_KEY":"","SUPABASE_ANON_KEY":""}

# TF_VAR_market_data_parameter_version=1
# TF_VAR_api_parameter_version=1


###############################################################################
# CI/CD
#
# These belong in GitHub repo secrets, not here. Listed so the names are in one
# place; leave the values blank in any file on disk.
#   AWS_DEPLOY_ROLE_ARN   -> arn of the module.github_oidc deploy role
###############################################################################
# AWS_DEPLOY_ROLE_ARN=


###############################################################################
# Outputs, populated after apply. Convenience only, never secret.
###############################################################################
# ECR_REPOSITORY_URL=
# ECS_CLUSTER_NAME=mqsmaster-prod-cluster
# MARKET_TASK_FAMILY=mqsmaster-prod
# LOG_GROUP_NAME=/ecs/mqsmaster-prod
